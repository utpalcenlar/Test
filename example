// --- RED FONT FOR ASSIGNED COLUMN ON RAW DATA TABS ---
    const rawSheets = ["Task Summary", "Violations - Liens"];
    for (let sheetName of rawSheets) {
        const rawSheet = workbook.getWorksheet(sheetName);
        if (!rawSheet) continue;

        const rawUsedRange = rawSheet.getUsedRange();
        if (!rawUsedRange) continue;

        const rawHeaders = rawUsedRange.getValues()[0] as string[];
        let assignColIdx = -1;
        
        for (let c = 0; c < rawHeaders.length; c++) {
            if (String(rawHeaders[c]).trim().toUpperCase() === "ASSIGNED") {
                assignColIdx = c;
                break;
            }
        }

        if (assignColIdx !== -1) {
            const colLetter = columnIndexToLetter(assignColIdx);
            const totalRows = rawUsedRange.getRowCount();
            rawSheet.getRange(`${colLetter}1:${colLetter}${totalRows}`).getFormat().getFont().setColor("#FF0000");
        }
    }
