    loanSheet.getUsedRange().getFormat().autofitRows();
    console.log("Detailed Loan Summary sheet created successfully.");
}

// ── Helper: apply red/orange/yellow date highlighting ──────────
function applyDateHighlighting(
    pivotSheet: ExcelScript.Worksheet,
    pivot: ExcelScript.PivotTable,
    todayTime: number
) {
    const layout = pivot.getLayout();
    const pivotRange = layout.getRange();

    // Use getTexts() instead of getValues() — more reliable for formatted dates
    const pivotTexts = pivotRange.getTexts();
    const pivotRowCount = pivotTexts.length;
    const pivotColCount = pivotTexts[0].length;

    console.log(`Pivot: ${pivotRowCount} rows x ${pivotColCount} cols`);

    const threeDaysTime = todayTime + 3 * 24 * 60 * 60 * 1000;

    const RED = "FF0000";
    const ORANGE = "FFA500";
    const YELLOW = "FFFF00";

    // ── Find which row contains the actual date headers ───────────
    // Scan rows until we find one where col 1 looks like a date
    let dateHeaderRow = -1;
    for (let row = 0; row < pivotRowCount; row++) {
        const cellText = pivotTexts[row][1];
        if (cellText && cellText !== "" && !isNaN(Date.parse(String(cellText)))) {
            dateHeaderRow = row;
            console.log(`Date header row found at index: ${row}`);
            break;
        }
    }

    if (dateHeaderRow === -1) {
        console.log("ERROR: Could not find date header row in pivot.");
        return;
    }

    const headerRow = pivotTexts[dateHeaderRow];

    for (let col = 1; col < pivotColCount - 1; col++) {
        const headerText = String(headerRow[col] ?? "").trim();
        if (!headerText || headerText === "Grand Total") continue;

        const colDate = new Date(headerText);
        colDate.setHours(0, 0, 0, 0);
        const colTime = colDate.getTime();

        if (isNaN(colTime)) {
            console.log(`  col[${col}]: could not parse "${headerText}" as date, skipping`);
            continue;
        }

        console.log(`  col[${col}]: "${headerText}" → ${colDate.toDateString()}`);

        let fillColor: string | null = null;
        if (colTime < todayTime) {
            fillColor = RED;
        } else if (colTime === todayTime) {
            fillColor = ORANGE;
        } else if (colTime <= threeDaysTime) {
            fillColor = YELLOW;
        }

        if (!fillColor) continue;

        // Color entire column from header row down to last data row (exclude Grand Total row)
        for (let row = dateHeaderRow; row < pivotRowCount - 1; row++) {
            pivotRange.getCell(row, col).getFormat().getFill().setColor(fillColor);
        }
    }
}

// ── Helper: apply full grid borders to a range ─────────────────
function applyBorders(range: ExcelScript.Range) {
    const sides = [
        ExcelScript.BorderIndex.edgeTop,
        ExcelScript.BorderIndex.edgeBottom,
        ExcelScript.BorderIndex.edgeLeft,
        ExcelScript.BorderIndex.edgeRight,
        ExcelScript.BorderIndex.insideHorizontal,
        ExcelScript.BorderIndex.insideVertical
    ];
    for (const side of sides) {
        range.getFormat().getRangeBorder(side).setStyle(ExcelScript.BorderLineStyle.continuous);
        range.getFormat().getRangeBorder(side).setWeight(ExcelScript.BorderWeight.thin);
    }
}

// ── Helper: convert 0-based column index to Excel letter(s) ────
function columnIndexToLetter(index: number): string {
    let letter = "";
    let n = index + 1;
    while (n > 0) {
        const rem = (n - 1) % 26;
        letter = String.fromCharCode(65 + rem) + letter;
        n = Math.floor((n - 1) / 26);
    }
    return letter;
}

