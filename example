function main(workbook: ExcelScript.Workbook) {

  // ══════════════════════════════════════════════════════════════
  // TASK SUMMARY TAB
  // ══════════════════════════════════════════════════════════════

  // ── 1. Get the Task Summary sheet ─────────────────────────────
  const sheet = workbook.getWorksheet("Task Summary");
  if (!sheet) {
    console.log("ERROR: Could not find a sheet named 'Task Summary'.");
    return;
  }

  const usedRange = sheet.getUsedRange();
  if (!usedRange) {
    console.log("ERROR: The Task Summary sheet appears to be empty.");
    return;
  }

  const data        = usedRange.getValues();
  const totalRows   = data.length;
  const totalCols   = (data[0] as unknown[]).length;
  const headerRow   = data[0] as string[];

  // ── 2. Locate required columns ────────────────────────────────
  let taskIdIdx           = -1;
  let reoFileLocIdx       = -1;
  let procIdIdx           = -1;
  let vendorVsCenlarIdx   = -1;
  let inspServicerIdx     = -1;

  for (let c = 0; c < totalCols; c++) {
    const h = String(headerRow[c]).trim().toUpperCase();
    if (h === "TASK_ID")                    taskIdIdx         = c;
    if (h === "REO_FILE_LOCATION_CODE")     reoFileLocIdx     = c;
    if (h === "PROC_ID")                    procIdIdx         = c;
    if (h === "VENDOR VS CENLAR TASK")      vendorVsCenlarIdx = c;
    if (h === "INSPECTION_SERVICER_ID")     inspServicerIdx   = c;
  }

  // Validate
  if (taskIdIdx === -1) {
    console.log("ERROR: Column 'TASK_ID' not found.");
    return;
  }
  if (reoFileLocIdx === -1) {
    console.log("ERROR: Column 'REO_FILE_LOCATION_CODE' not found.");
    return;
  }
  if (procIdIdx === -1) {
    console.log("ERROR: Column 'PROC_ID' not found.");
    return;
  }
  if (vendorVsCenlarIdx === -1) {
    console.log("ERROR: Column 'VENDOR VS CENLAR TASK' not found.");
    return;
  }
  if (inspServicerIdx === -1) {
    console.log("ERROR: Column 'INSPECTION_SERVICER_ID' not found.");
    return;
  }

  // ── 3. Sort Task Summary by TASK_ID (ascending) ───────────────
  usedRange.getSort().apply(
    [{ key: taskIdIdx, ascending: true }],
    false,
    true,
    ExcelScript.SortOrientation.rows
  );

  const sortedData = usedRange.getValues() as string[][];

  // ── 4. Highlight REO_FILE_LOCATION_CODE column Yellow ─────────
  const reoColLetter = columnIndexToLetter(reoFileLocIdx);
  sheet.getRange(`${reoColLetter}1:${reoColLetter}${totalRows}`)
    .getFormat().getFill().setColor("#FFFF00");

  // ── 5. Rename PROC_ID header → 'Assigned' ─────────────────────
  sheet.getCell(0, procIdIdx).setValue("Assigned");

  // ── 6. Write Assigned values for VENDOR rows ──────────────────
  for (let r = 1; r < totalRows; r++) {
    const vendorVal   = String(sortedData[r][vendorVsCenlarIdx]).trim().toUpperCase();
    const servicerVal = String(sortedData[r][inspServicerIdx]).trim().toUpperCase();

    if (vendorVal === "VENDOR") {
      if (servicerVal === "SAFEGUARD") {
        const cell = sheet.getCell(r, procIdIdx);
        cell.setNumberFormat("@");
        cell.setValue("060000");
      } else if (servicerVal === "MORTGAGE SPECIALISTS INT" || servicerVal === "MCS" ) {
        const cell = sheet.getCell(r, procIdIdx);
        cell.setNumberFormat("@");
        cell.setValue("030000");
      }
    }
  }

  console.log("Task Summary completed successfully.");

  // ══════════════════════════════════════════════════════════════
  // VIOLATIONS - LIENS TAB
  // ══════════════════════════════════════════════════════════════

  // ── 1. Get the Violations - Liens sheet ───────────────────────
  const violSheet = workbook.getWorksheet("Violations - Liens");
  if (!violSheet) {
    console.log("ERROR: Could not find a sheet named 'Violations - Liens'.");
    return;
  }

  const violUsedRange = violSheet.getUsedRange();
  if (!violUsedRange) {
    console.log("ERROR: The Violations - Liens sheet appears to be empty.");
    return;
  }

  const violTotalRows = violUsedRange.getValues().length;

  // ── 2. Sort Violations - Liens by TASK_ID (column L = index 11)
  const taskIdColViol = 11; // Column L (0-based)
  violUsedRange.getSort().apply(
    [{ key: taskIdColViol, ascending: true }],
    false,
    true,
    ExcelScript.SortOrientation.rows
  );

  // ── 3. Rename PROC_ID → 'Assigned' on Violations - Liens ──────
  const violData = violUsedRange.getValues() as string[][];
  const violHeaders = violData[0] as string[];
  let violProcIdIdx = -1;
  for (let c = 0; c < violHeaders.length; c++) {
    if (String(violHeaders[c]).trim().toUpperCase() === "PROC_ID") {
      violProcIdIdx = c;
      break;
    }
  }
  if (violProcIdIdx === -1) {
    console.log("ERROR: Column 'PROC_ID' not found on Violations - Liens tab.");
    return;
  }
  violSheet.getCell(0, violProcIdIdx).setValue("Assigned");

  // ── 4. Highlight REO_FILE_LOCATION_CODE column I Yellow ───────
  const reoColViol = 8; // Column I (0-based)
  const reoColLetterViol = columnIndexToLetter(reoColViol);
  violSheet.getRange(`${reoColLetterViol}1:${reoColLetterViol}${violTotalRows}`)
    .getFormat().getFill().setColor("#FFFF00");

  console.log("Violations - Liens completed successfully.");
}

// ── Helper: convert 0-based column index to Excel letter(s) ───
function columnIndexToLetter(index: number): string {
  let letter = "";
  let n = index + 1;
  while (n > 0) {
    const rem = (n - 1) % 26;
    letter = String.fromCharCode(65 + rem) + letter;
    n = Math.floor((n - 1) / 26);
  }
  return letter;
}


